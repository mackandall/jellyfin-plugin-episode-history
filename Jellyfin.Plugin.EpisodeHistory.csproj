<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Jellyfin 12.0.x runs on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Jellyfin.Plugin.EpisodeHistory</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the running Jellyfin server version; a mismatch is the usual cause of
         load failures. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
    <!-- Compile-time only: Jellyfin 12.0.0 already loads Microsoft.Data.Sqlite.Core 10.0.11
         (and an initialised SQLitePCLRaw) for its own database, so the plugin uses the
         server's copy instead of shipping a second one. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Build-time resolution of Microsoft.AspNetCore.Mvc for Web/HistoryController.cs; the
       server's own shared framework provides it at run time. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\guidemenu.js" />
    <EmbeddedResource Include="Web\recordings.js" />
  </ItemGroup>

  <!-- Plain files next to the DLL: meta.json's "imagePath" is the only icon mechanism that
       works for a side-loaded plugin (IHasEmbeddedImage is ignored for those). -->
  <ItemGroup>
    <None Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="meta.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
